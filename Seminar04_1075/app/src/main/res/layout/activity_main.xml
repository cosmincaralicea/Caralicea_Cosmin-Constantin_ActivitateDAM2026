<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_clasic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Adaugă Calculator (Clasic)"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_ai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Adaugă Calculator (Design AI ✨)"
        android:backgroundTint="#2196F3"
        app:layout_constraintTop_toBottomOf="@id/btn_clasic" />

    <Button
        android:id="@+id/btn_afiseaza_lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="3. Afișează Lista Calculatoare"
        app:layout_constraintTop_toBottomOf="@id/btn_ai" />

    <Button
        android:id="@+id/btn_imagini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="4. Imaginile Domeniului (Web)"
        android:backgroundTint="#2E7D32"
        app:layout_constraintTop_toBottomOf="@id/btn_afiseaza_lista" />

    <TextView
        android:id="@+id/tv_rezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Niciun calculator adăugat momentan."
        android:textSize="16sp"
        android:textStyle="italic"
        app:layout_constraintTop_toBottomOf="@id/btn_imagini" />

</androidx.constraintlayout.widget.ConstraintLayout>